{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.uscppc.fr" }],
      "destination": "https://uscppc.fr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.uscppc.fr" }],
      "destination": "https://uscppc.fr/:path*",
      "permanent": true
    }
  ]
}
